# Only needed to RE-RUN the systems (scripts/run_inference.py) or semantic WER.
# Scoring your own transcripts needs no key at all.
# Copy to .env; .env is gitignored and no key is ever read from source.

CONVOZEN_API_KEY=          # Akshara, via `pip install convozen`
AKSHARA_MODEL=akshara-pro
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
SMALLEST_API_KEY=
DEEPGRAM_API_KEY=

# semantic WER judge
GEMINI_API_KEY=
SEMANTIC_WER_JUDGE_MODEL=gemini-2.5-flash
